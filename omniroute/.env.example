# OmniRoute MVP — configuration
#
# A provider is enabled only when its API key is set. Base URLs are optional
# and default to each provider's public API.

# Gateway
OMNIROUTE_PORT=8787
# Optional: require clients to send `Authorization: Bearer <this>`.
# OMNIROUTE_API_KEY=

# Providers (set the keys you have)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# MISTRAL_API_KEY=
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
