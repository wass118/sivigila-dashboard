{
  "name": "omniroute-mini",
  "version": "0.1.0",
  "private": true,
  "description": "Clean-room MVP of OmniRoute's core: a single OpenAI-compatible endpoint that routes and falls back across multiple AI providers.",
  "type": "module",
  "bin": {
    "omniroute": "dist/cli.js"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts serve",
    "serve": "tsx src/cli.ts serve",
    "cli": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
